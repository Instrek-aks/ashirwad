# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/ashirwad_crm

# JWT Secret for Admin Auth
JWT_SECRET=ashirwad_super_secure_jwt_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Default Super Admin Seed Credentials
DEFAULT_ADMIN_EMAIL=admin@ashirwad.com
DEFAULT_ADMIN_PASSWORD=Admin@12345

# SMTP / Email Service Configuration
# Supports Gmail, Hostinger, Zoho, cPanel, or any standard SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM_NAME="Ashirwad Packaging Admin"
EMAIL_FROM_ADDRESS=your-email@gmail.com
